# Database Configuration
DB_PASSWORD=your_secure_db_password_here
REDIS_PASSWORD=your_secure_redis_password_here

# Chatwoot Integration
CHATWOOT_URL=https://chatwoot.seudominio.com.br
CHATWOOT_TOKEN=your_chatwoot_api_token_here
CHATWOOT_FRONTEND_URL=https://chatwoot.seudominio.com.br
CHATWOOT_DB_PASSWORD=your_chatwoot_db_password_here
CHATWOOT_SECRET_KEY=your_chatwoot_secret_key_here

# Docker Configuration
COMPOSE_PROJECT_NAME=sistema-clinica
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_TAG=latest

# Deploy Configuration
AUTO_ROLLBACK=true
BACKUP_RETENTION_DAYS=7
HEALTH_CHECK_TIMEOUT=30000
DEPLOY_TIMEOUT=600000

# Environment URLs
DEV_URL=https://dev.alphaclinics.servinder.com.br
HMG_URL=https://hmg.alphaclinics.servinder.com.br
PROD_URL=https://alphaclinics.servinder.com.br

# Monitoring & Alerting
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
ALERT_EMAIL=admin@seudominio.com.br

# Security
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_encryption_key_here
API_TOKEN=your_api_token_here

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Performance
NODE_ENV=production
CACHE_TTL=3600
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Integration Services
EVOLUTION_API_URL=https://evolutionapi.seudominio.com.br
EVOLUTION_API_KEY=your_evolution_api_key

# Backup Configuration
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=your_s3_access_key
BACKUP_S3_SECRET_KEY=your_s3_secret_key
