# Multi-stage build for Laravel Application - Ubuntu Base
FROM node:22-slim AS node-build

WORKDIR /app

COPY package.json package-lock.json* ./

# Install dependencies
RUN npm ci --retry 3 --retry-delay 5 || npm install

COPY resources ./resources
COPY vite.config.js ./vite.config.js

# Build assets
RUN npm run build || echo "Build assets skipped - continuing"

# PHP Stage - Ubuntu Base
FROM php:8.4-fpm AS php-build

# Install system dependencies
RUN apt-get update && \
    apt-get install -y \
    postgresql-client \
    libpq-dev \
    libzip-dev \
    zip \
    unzip \
    libpng-dev \
    libxml2-dev \
    libonig-dev \
    libjpeg-dev \
    libfreetype6-dev \
    && rm -rf /var/lib/apt/lists/*

# Install PHP extensions
RUN docker-php-ext-configure gd --with-freetype --with-jpeg && \
    docker-php-ext-install \
    pdo_pgsql \
    bcmath \
    zip \
    gd \
    xml \
    mbstring

# Copy application files
COPY app ./app
COPY bootstrap ./bootstrap
COPY config ./config
COPY database ./database
COPY routes ./routes
COPY resources/lang ./resources/lang
COPY composer.json composer.lock ./

# Install PHP dependencies
RUN composer install --prefer-dist --no-interaction --optimize-autoloader --no-scripts

# Application Stage - Ubuntu Base
FROM php:8.4-fpm AS app

# Environment variables
ENV NPM_CONFIG_LEGACY_PEER_DEPS=true

# Install runtime dependencies
RUN apt-get update && \
    apt-get install -y \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install PHP extensions
RUN docker-php-ext-install pdo_pgsql bcmath

# Create app user
RUN groupadd -r app && \
    useradd -r -g app app

# Set working directory
WORKDIR /var/www/html

# Copy from build stages
COPY --from=node-build /app/public/build ./public/build
COPY --from=php-build --chown=app:app /var/www/html .

# Set permissions
RUN chown -R app:app /var/www/html \
    && chmod -R 755 /var/www/html/storage \
    && chmod -R 755 /var/www/html/bootstrap/cache

# Switch to app user
USER app

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080 || exit 1

# Start PHP-FPM
CMD ["php-fpm"]
