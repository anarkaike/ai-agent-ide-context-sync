{
  "name": "chatwoot-security-compliance",
  "version": "2.0.0",
  "description": "Skill completa de Segurança e Compliance para Chatwoot - GDPR, LGPD, ISO 27001, SOC 2 e auditoria automatizada",
  "category": "security",
  "author": "AI Agent Collective",
  "license": "MIT",
  "tags": ["security", "compliance", "gdpr", "lgpd", "iso27001", "soc2", "audit", "privacy"],
  "main": "index.js",
  "capabilities": [
    "data_protection",
    "privacy_compliance",
    "security_monitoring",
    "audit_automation",
    "risk_assessment",
    "incident_response",
    "access_control",
    "encryption_management",
    "vulnerability_scanning",
    "compliance_reporting",
    "policy_enforcement",
    "data_governance",
    "security_analytics",
    "threat_detection",
    "breach_notification"
  ],
  "platforms": ["linux", "macos", "windows"],
  "dependencies": {
    "node": ">=14.0.0",
    "crypto": "^1.0.1",
    "bcrypt": "^5.1.0",
    "jsonwebtoken": "^9.0.0",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.0",
    "audit-log": "^2.1.0",
    "winston": "^3.8.0",
    "node-acl": "^3.0.0",
    "joi": "^17.9.0"
  },
  "compliance_frameworks": {
    "gdpr": {
      "requirements": [
        "lawfulness_fairness_transparency",
        "purpose_limitation",
        "data_minimization",
        "accuracy",
        "storage_limitation",
        "integrity_confidentiality",
        "accountability"
      ],
      "data_subject_rights": [
        "right_to_be_informed",
        "right_of_access",
        "right_to_rectification",
        "right_to_erasure",
        "right_to_restrict_processing",
        "right_to_data_portability",
        "right_to_object",
        "rights_related_to_automated_decision_making"
      ],
      "automated_controls": [
        "consent_management",
        "data_breach_detection",
        "privacy_impact_assessment",
        "data_protection_officer_coordination",
        "record_of_processing_activities"
      ]
    },
    "lgpd": {
      "requirements": [
        "legal_basis",
        "purpose",
        "necessity",
        "transparency",
        "data_subject_rights",
        "data_security",
        "accountability"
      ],
      "data_subject_rights": [
        "confirmation_of_existence",
        "access",
        "correction",
        "elimination_blocking_anonymization",
        "data_portability",
        "information_about_sharing",
        "revocation_of_consent"
      ],
      "national_authority": {
        "anpd_coordination": true,
        "national_regulations": true,
        "brazilian_specific_requirements": true
      }
    },
    "iso27001": {
      "domains": [
        "information_security_policies",
        "organization_of_information_security",
        "human_resource_security",
        "asset_management",
        "access_control",
        "cryptography",
        "physical_and_environmental_security",
        "operations_security",
        "communications_security",
        "system_acquisition_development_maintenance",
        "supplier_relationships",
        "information_security_incident_management",
        "information_security_aspects_of_business_continuity_management",
        "compliance"
      ],
      "controls": {
        "mandatory": 114,
        "optional": 35,
        "implementation_status": "automated_tracking"
      }
    },
    "soc2": {
      "trust_services_criteria": [
        "security",
        "availability",
        "processing_integrity",
        "confidentiality",
        "privacy"
      ],
      "common_criteria": [
        "common_criteria_1_control_environment",
        "common_criteria_2_communication",
        "common_criteria_3_risk_assessment",
        "common_criteria_4_monitoring",
        "common_criteria_5_control_activities",
        "common_criteria_6_logical_and_physical_access",
        "common_criteria_7_system_operations",
        "common_criteria_8_change_management",
        "common_criteria_9_risk_mitigation"
      ]
    }
  },
  "security_controls": {
    "data_protection": {
      "encryption": {
        "data_at_rest": "aes_256",
        "data_in_transit": "tls_1_3",
        "key_management": "hsm_based",
        "rotation_policy": "90_days"
      },
      "anonymization": {
        "pseudonymization": true,
        "data_masking": true,
        "tokenization": true,
        "aggregation": true
      },
      "retention": {
        "automated_deletion": true,
        "retention_policies": true,
        "legal_hold": true,
        "archive_management": true
      }
    },
    "access_control": {
      "authentication": {
        "multi_factor_authentication": true,
        "single_sign_on": true,
        "biometric_authentication": true,
        "password_policies": true
      },
      "authorization": {
        "role_based_access_control": true,
        "attribute_based_access_control": true,
        "least_privilege_principle": true,
        "segregation_of_duties": true
      },
      "session_management": {
        "session_timeout": true,
        "concurrent_sessions": true,
        "session_encryption": true,
        "revocation_capability": true
      }
    },
    "monitoring": {
      "security_monitoring": {
        "intrusion_detection": true,
        "anomaly_detection": true,
        "behavioral_analysis": true,
        "threat_intelligence": true
      },
      "audit_logging": {
        "comprehensive_logging": true,
        "tamper_protection": true,
        "log_encryption": true,
        "centralized_collection": true
      },
      "vulnerability_management": {
        "automated_scanning": true,
        "patch_management": true,
        "penetration_testing": true,
        "risk_assessment": true
      }
    }
  },
  "privacy_features": {
    "consent_management": {
      "granular_consent": true,
      "withdrawal_capability": true,
      "consent_recording": true,
      "consent_analytics": true
    },
    "data_subject_rights": {
      "access_requests": true,
      "rectification_requests": true,
      "erasure_requests": true,
      "portability_requests": true,
      "restriction_requests": true,
      "objection_requests": true
    },
    "privacy_by_design": {
      "data_minimization": true,
      "purpose_limitation": true,
        "privacy_impact_assessment": true,
        "design_review": true
    }
  },
  "audit_automation": {
    "automated_audits": {
      "continuous_monitoring": true,
      "compliance_assessment": true,
      "gap_analysis": true,
      "remediation_tracking": true
    },
    "audit_trails": {
      "user_activity_logging": true,
      "data_access_logging": true,
      "system_change_logging": true,
      "admin_action_logging": true
    },
    "reporting": {
      "compliance_reports": true,
      "audit_reports": true,
      "risk_assessments": true,
      "executive_summaries": true
    }
  },
  "incident_response": {
    "incident_management": {
      "detection": true,
      "classification": true,
      "containment": true,
      "eradication": true,
      "recovery": true,
      "lessons_learned": true
    },
    "breach_notification": {
      "timeline_tracking": true,
        "regulatory_notification": true,
        "customer_notification": true,
        "media_management": true
    },
    "crisis_management": {
      "incident_response_team": true,
      "communication_plan": true,
      "business_continuity": true,
      "disaster_recovery": true
    }
  },
  "risk_management": {
    "risk_assessment": {
      "risk_identification": true,
      "risk_analysis": true,
      "risk_evaluation": true,
      "risk_treatment": true
    },
    "risk_monitoring": {
      "key_risk_indicators": true,
      "risk_dashboard": true,
      "risk_trending": true,
      "early_warning_system": true
    }
  },
  "workflows": [
    {
      "name": "setup_compliance_framework",
      "description": "Setup completo de framework de compliance",
      "steps": [
        "assess_compliance_requirements",
        "configure_data_protection",
        "setup_access_controls",
        "implement_audit_logging",
        "create_policies_procedures",
        "train_staff",
        "validate_compliance"
      ]
    },
    {
      "name": "handle_data_subject_request",
      "description": "Processamento automatizado de requisições de titulares",
      "steps": [
        "verify_identity",
        "validate_request",
        "search_collect_data",
        "apply_redactions",
        "prepare_response",
        "secure_delivery",
        "audit_log"
      ]
    },
    {
      "name": "security_incident_response",
      "description": "Resposta automatizada a incidentes de segurança",
      "steps": [
        "incident_detection",
        "impact_assessment",
        "containment_actions",
        "notification_procedures",
        "remediation_activities",
        "post_incident_review"
      ]
    },
    {
      "name": "compliance_audit_cycle",
      "description": "Ciclo completo de auditoria de compliance",
      "steps": [
        "audit_planning",
        "data_collection",
        "compliance_testing",
        "gap_identification",
        "remediation_planning",
        "implementation_tracking",
        "reporting"
      ]
    }
  ],
  "monitoring": {
    "security_metrics": [
      "security_incident_count",
      "vulnerability_count",
      "patch_compliance_rate",
      "access_violations",
      "failed_authentication_attempts",
      "data_breach_indicators"
    ],
    "compliance_metrics": [
      "policy_compliance_rate",
      "training_completion_rate",
      "audit_findings",
      "remediation_time",
      "data_subject_request_processing_time"
    ],
    "privacy_metrics": [
      "consent_management_rate",
      "data_minimization_score",
      "privacy_impact_assessments_completed",
      "data_subject_rights_fulfillment_rate"
    ]
  },
  "integration_capabilities": {
    "security_tools": [
      "siem_systems",
      "vulnerability_scanners",
      "identity_providers",
      "key_management_systems"
    ],
    "compliance_platforms": [
      "governance_risk_compliance_tools",
      "audit_management_systems",
      "policy_management_platforms"
    ],
    "monitoring_solutions": [
      "security_information_event_management",
      "log_management_systems",
      "threat_intelligence_platforms"
    ]
  },
  "documentation": {
    "policies": [
      "information_security_policy",
      "privacy_policy",
      "data_protection_policy",
      "acceptable_use_policy",
      "incident_response_policy"
    ],
    "procedures": [
      "data_subject_request_procedure",
      "security_incident_procedure",
      "access_request_procedure",
      "change_management_procedure"
    ],
    "guidelines": [
      "data_classification_guidelines",
      "password_security_guidelines",
      "remote_access_guidelines",
      "vendor_management_guidelines"
    ]
  }
}
