# Configuração S3 Contabo
CONTABO_ACCESS_KEY=sua_access_key_aqui
CONTABO_SECRET_KEY=sua_secret_key_aqui

# Configurações adicionais (opcionais)
S3_ENDPOINT=https://eu2.contabostorage.com
S3_REGION=eu-central-1
S3_BUCKET=ai-agent-backups

# Configurações de backup
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12
BACKUP_BLOCK_SIZE=4096
BACKUP_COMPRESSION_LEVEL=6

# Configurações de Alertas - Telegram
TELEGRAM_BOT_TOKEN=seu_bot_token_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# Configurações de Alertas - WhatsApp (CallMeBot)
WHATSAPP_PHONE=+55119XXXXXXXXX
WHATSAPP_API_KEY=sua_api_key_aqui
